> eig_test = function(X, B = 5000) {
+     X = X[complete.cases(X), ]
+     ev = function(M) max(eigen(cor(M), symmetric = TRUE, only.values = TRUE)$values)
+     obs = ev(X)
+     null = replicate(B, ev(as.data.frame(lapply(X, sample))))
+     c(n = nrow(X), largest = obs, null_max = max(null), p = (sum(null >= 
+         obs) + 1)/(B + 1))
+ }

> set.seed(20261113)

> eig_test(select(zap_labels(read_sav("data/Madiera data 2024.sav")), 
+     Race_Sat, MTI, BRS, CDRISC, CE))
