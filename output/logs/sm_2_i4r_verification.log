> long = filter(mutate(pivot_longer(mutate(filter(mutate(zap_labels(read_sav("data/Madiera data 2024.sav")), 
+     id = row_number()), !is.na(Race_Sat)), group = ifelse(Race_Sat == 
+     5, 1, 0)), starts_with("Q16_"), names_to = "item", values_to = "coping"), 
+     time = as.integer(str_match(item, "^Q16_(\\d+)")[, 2]), tL = contr.poly(11)[time, 
+         1], tQ = contr.poly(11)[time, 2], tf = factor(time)), 
+     !is.na(coping))

> contrasts(long$tf) = contr.poly(11)

> fits = function(f, qname) {
+     cs = nlme::gls(f, data = long, correlation = nlme::corCompSymm(form = ~time | 
+         id))
+     ar1 = nlme::gls(f, data = long, correlation = nlme::corAR1(form = ~time | 
+         id))
+     un = nlme::gls(f, data = long, correlation = nlme::corSymm(form = ~time | 
+         id), weights = nlme::varIdent(form = ~1 | time), control = nlme::glsControl(msMaxIter = 200, 
+         opt = "optim"))
+     qp = function(m) summary(m)$tTable[qname, "p-value"]
+     c(CS = qp(cs), AR1 = qp(ar1), UN = qp(un), AIC_gap = AIC(cs) - 
+         AIC(ar1))
+ }

