+     time = as.integer(str_match(item, "^Q16_(\\d+)")[, 2])), 
+     id, group), lin = sum(coping * (time - 6)), quad = sum(coping * 
+     ((time - 6)^2 - 10)), .groups = "drop")

> mutate(summarise(group_by(pivot_longer(scores, c(lin, 
+     quad), names_to = "trend", values_to = "score"), trend), 
+     mean_0 = mean(score[group == 0]), mean_1 = mean(score[group == 
+         1]), t = t.test(score ~ group, var.equal = TRUE)$statistic, 
+     p = t.test(score ~ group, var.equal = TRUE)$p.value), F = t^2)
