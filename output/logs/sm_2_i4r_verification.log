+         q = qt(0.975, m$df.residual)
+         tibble(model = mod, level = ifelse(k > 0, "high", "low"), 
+             b = b, p = 2 * pt(-abs(b/se), m$df.residual), lo = b - 
+                 q * se, hi = b + q * se)
+     })
+ }

