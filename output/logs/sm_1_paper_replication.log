> fig1 = function(covs = NULL) {
+     d = mutate(drop_na(zap_labels(read_sav("data/Madiera data 2024.sav")), 
+         all_of(c("Race_Sat", "CE", "MTI", covs))), ce_c = CE - 
+         mean(CE), mt_c = MTI - mean(MTI))
+     full = lm(as.formula(paste("Race_Sat ~", paste(c("ce_c * mt_c", 
+         covs), collapse = " + "))), data = d)
+     red = update(full, . ~ . - ce_c:mt_c)
+     s = summary(full)
+     cat("\nn =", nrow(d), " R2 =", round(s$r.squared, 4), sprintf(" F(%d,%d) = %.2f, p = %.3f", 
+         s$fstatistic[2], s$fstatistic[3], s$fstatistic[1], pf(s$fstatistic[1], 
+             s$fstatistic[2], s$fstatistic[3], lower.tail = FALSE)), 
+         " dR2 =", round(s$r.squared - summary(red)$r.squared, 
+             3), "\n")
+     print(round(cbind(b = coef(full), confint(full), p = s$coefficients[, 
+         4]), 3))
+     print(anova(red, full))
+ }

