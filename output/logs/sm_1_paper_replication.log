> slopes = function(mod, covs) {
+     d = mutate(drop_na(zap_labels(read_sav("data/Madiera data 2024.sav")), 
+         all_of(c("Race_Sat", "CE", mod, covs))), ce_c = CE - 
+         mean(CE), w_c = .data[[mod]] - mean(.data[[mod]]))
+     m = lm(as.formula(paste("Race_Sat ~ ce_c * w_c +", paste(covs, 
+         collapse = " + "))), data = d)
+     V = vcov(m)
+     q = qt(0.975, m$df.residual)
+     map_dfr(c(high = 1, low = -1), function(k) {
+         w = k * sd(d[[mod]])
+         b = coef(m)["ce_c"] + w * coef(m)["ce_c:w_c"]
+         se = sqrt(V["ce_c", "ce_c"] + w^2 * V["ce_c:w_c", "ce_c:w_c"] + 
+             2 * w * V["ce_c", "ce_c:w_c"])
+         tibble(level = ifelse(k > 0, "high", "low"), b = b, lo = b - 
+             q * se, hi = b + q * se, p = 2 * pt(-abs(b/se), m$df.residual))
+     })
+ }

