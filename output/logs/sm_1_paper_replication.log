> fig_lines = function(mod, covs, rise_hi, rise_lo) {
+     d = mutate(drop_na(zap_labels(read_sav("data/Madiera data 2024.sav")), 
+         all_of(c("Race_Sat", "CE", mod, covs))), ce_c = CE - 
+         mean(CE), w_c = .data[[mod]] - mean(.data[[mod]]))
+     m = lm(as.formula(paste("Race_Sat ~ ce_c * w_c +", paste(covs, 
+         collapse = " + "))), data = d)
+     nd = function(x, w) bind_cols(tibble(ce_c = x, w_c = w), 
+         summarise(d, across(all_of(covs), mean)))
+     pred = function(x, w) predict(m, newdata = nd(x, w))
+     w_hi = sd(d[[mod]])
+     w_lo = -w_hi
+     b_hi = coef(m)["ce_c"] + w_hi * coef(m)["ce_c:w_c"]
+     b_lo = coef(m)["ce_c"] + w_lo * coef(m)["ce_c:w_c"]
+     x_cross = (pred(0, w_lo) - pred(0, w_hi))/(b_hi - b_lo)
+     c(slope_hi = b_hi, slope_lo = b_lo, x_cross = x_cross, y_cross = pred(x_cross, 
+         w_hi), span_hi = rise_hi/b_hi, span_lo = rise_lo/b_lo, 
+         sd_CE = sd(d$CE))
+ }

