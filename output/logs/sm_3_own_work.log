> stepdown = function(t0, tb) {
+     o = order(t0, decreasing = TRUE)
+     p = numeric(length(t0))
+     for (j in seq_along(o)) p[o[j]] = mean(apply(tb[, o[j:length(o)], 
+         drop = FALSE], 1, max) >= t0[o[j]])
+     p[o] = cummax(p[o])
+     p
+ }

