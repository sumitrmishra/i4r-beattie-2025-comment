> dt = mutate(filter(mutate(zap_labels(read_sav("data/Madiera data 2024.sav")), 
+     id = row_number()), if_all(starts_with("Q16_"), ~!is.na(.x))), 
+     group = ifelse(Race_Sat == 5, 1, 0))

> blocks = summarise(group_by(mutate(pivot_longer(dt, 
+     starts_with("Q16_"), names_to = "item", values_to = "coping"), 
+     time = as.integer(str_match(item, "^Q16_(\\d+)")[, 2])), 
+     id, group), lin = sum(coping * (time - 6)), quad = sum(coping * 
+     ((time - 6)^2 - 10)), .groups = "drop")

> diff_means = function(b) c(lin = mean(b$lin[b$group == 
+     1]) - mean(b$lin[b$group == 0]), quad = mean(b$quad[b$group == 
+     1]) - mean(b$quad[b$group == 0]))

> set.seed(20261113)

> bt = replicate(5000, {
+     b = ungroup(slice_sample(group_by(blocks, group), prop = 1, 
+         replace = TRUE))
+     diff_means(b)
+ })

> apply(bt, 1, quantile, c(0.025, 0.975))
