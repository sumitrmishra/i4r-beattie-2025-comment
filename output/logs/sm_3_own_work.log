> sharpened_q = function(p) {
+     m = length(p)
+     r = rank(p, ties.method = "first")
+     ps = sort(p)
+     q = rep(1, m)
+     for (qq in seq(1, 0.001, by = -0.001)) {
+         q1 = qq/(1 + qq)
+         k = max(c(0, which(ps <= q1 * seq_len(m)/m)))
+         q2 = q1 * m/(m - k)
+         q[r <= max(c(0, which(ps <= q2 * seq_len(m)/m)))] = qq
+     }
+     q
+ }

