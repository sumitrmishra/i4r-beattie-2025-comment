> retrodesign = function(A, s, df, alpha = 0.05, n.sims = 1e+05) {
+     z = qt(1 - alpha/2, df)
+     p.hi = 1 - pt(z - A/s, df)
+     p.lo = pt(-z - A/s, df)
+     power = p.hi + p.lo
+     e = A + s * rt(n.sims, df)
+     sig = abs(e) > s * z
+     c(power = power, typeS = p.lo/power, typeM = mean(abs(e)[sig])/A)
+ }

